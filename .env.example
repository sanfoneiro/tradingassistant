# Postgres — set automatically by the Vercel ↔ Neon integration
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# Bearer token the scheduled agents send on POST /api/ingest
# Generate with: openssl rand -hex 32
INGEST_TOKEN=""

# Passphrase for the UI. Set it, then log in once at /login
APP_PASSWORD=""

# Secret used to sign the session cookie
# Generate with: openssl rand -hex 32
SESSION_SECRET=""

# Optional — Telegram alerts from the Zone Proximity Watcher
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
