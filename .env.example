# Postgres — set automatically by the Vercel ↔ Neon integration
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# Bearer token the scheduled agents send on POST /api/ingest
# Generate with: openssl rand -hex 32
INGEST_TOKEN=""

# Passphrase for the UI. Set it, then log in once at /login
APP_PASSWORD=""

# Secret used to sign the session cookie
# Generate with: openssl rand -hex 32
SESSION_SECRET=""

# Market data — daily bars for the zone engine and for wishlist proximity.
# Key from https://massive.com/dashboard/keys
#
# Note: .env on this machine is generated by `vercel env pull`, so a value
# added here by hand is overwritten on the next pull. Set it in Vercel →
# Settings → Environment Variables, then re-pull.
MASSIVE_API_KEY=""

# Optional — Telegram alerts from the Zone Proximity Watcher
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
